{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wxsd-sales.github.io/macro-template/project.config.schema.json",
  "title": "Macro template project configuration",
  "description": "Single source of truth consumed by scripts/apply-config.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "title", "org", "repo"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URL to this JSON schema (enables editor validation)."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Package/macro name in kebab-case."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display title."
    },
    "description": {
      "type": "string",
      "description": "One-sentence description of the macro."
    },
    "author": {
      "type": "string",
      "description": "Author name (may be empty)."
    },
    "org": {
      "type": "string",
      "minLength": 1,
      "description": "GitHub organisation or user that hosts the repository."
    },
    "repo": {
      "type": "string",
      "minLength": 1,
      "description": "GitHub repository name (used for the Pages base URL)."
    },
    "macro": {
      "type": "object",
      "additionalProperties": false,
      "description": "Default macro settings written into the macro's CONFIG block.",
      "properties": {
        "warningMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440,
          "description": "Minutes before the booking ends that the alert is shown.",
          "default": 5
        },
        "alertDurationSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600,
          "description": "Seconds the alert stays on screen; 0 leaves it up until cleared.",
          "default": 30
        },
        "alertTitle": {
          "type": "string",
          "maxLength": 255,
          "description": "Heading shown on the alert.",
          "default": "Meeting ending soon"
        }
      }
    }
  }
}
